---
import type { Project } from "../lib/projects";
import { categoryLabels, getProjectHref } from "../lib/projects";

interface Props {
  project: Project;
  coverUrl?: string;
}

const { project, coverUrl } = Astro.props;
const projectHref = getProjectHref(project);
const href = project.data.external
  ? projectHref
  : `${import.meta.env.BASE_URL.replace(/\/$/, "")}${projectHref}`;
const linkLabel = project.data.external ? `${project.data.title} 외부 사이트 열기` : `${project.data.title} 상세 보기`;
---

<article class="project-card">
  <a
    class="cover-link"
    href={href}
    aria-label={linkLabel}
    target={project.data.external ? "_blank" : undefined}
    rel={project.data.external ? "noopener noreferrer" : undefined}
  >
    {
      coverUrl ? (
        <img src={coverUrl} alt="" loading="lazy" />
      ) : (
        <div class="cover-fallback" aria-hidden="true">{project.data.category}</div>
      )
    }
  </a>
  <div class="project-body">
    <div class="meta-row">
      <span>{categoryLabels[project.data.category]}</span>
      {project.data.year && <span>{project.data.year}</span>}
      {project.data.external && <span>External</span>}
    </div>
    <h3>
      <a
        href={href}
        target={project.data.external ? "_blank" : undefined}
        rel={project.data.external ? "noopener noreferrer" : undefined}
      >
        {project.data.title}
      </a>
    </h3>
    <p>{project.data.description}</p>
    {
      project.data.tags.length > 0 && (
        <ul class="tags" aria-label="Tags">
          {project.data.tags.slice(0, 4).map((tag) => <li>{tag}</li>)}
        </ul>
      )
    }
  </div>
</article>
