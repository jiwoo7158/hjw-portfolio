---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { homepage } from "../data/home";
import { categoryLabels, sortProjects, uniqueCategories } from "../lib/projects";

const allProjects = await getCollection("projects");
const projects = sortProjects(allProjects.filter((project) => !project.data.draft));
const categories = uniqueCategories(projects);

const coverModules = import.meta.glob<{ default: string | { src: string } }>(
  "/src/content/projects/**/*.{png,jpg,jpeg,webp,avif,svg}"
);

async function loadCoverUrl(project: (typeof projects)[number]) {
  const cover = project.data.cover?.image;
  if (!cover) return undefined;
  const load = coverModules[`/src/content/projects/${project.data.category}/${project.data.slug}/${cover}`];
  if (!load) return undefined;
  const mod = await load();
  return typeof mod.default === "string" ? mod.default : mod.default.src;
}

const coverUrls = new Map(
  await Promise.all(projects.map(async (project) => [project.data.slug, await loadCoverUrl(project)] as const))
);
---

<BaseLayout title={homepage.hero.title} description={homepage.hero.lead}>
  <section class="hero">
    <img class="hero-art" src={`${import.meta.env.BASE_URL}assets/portfolio-field.svg`} alt="" />
    <div class="hero-inner">
      <p class="eyebrow">{homepage.hero.eyebrow}</p>
      <h1>{homepage.hero.title}</h1>
      <p class="lead">{homepage.hero.lead}</p>
      <div class="hero-actions" aria-label="Primary links">
        {homepage.links.map((link) => <a href={link.href}>{link.label}</a>)}
      </div>
    </div>
  </section>

  <section class="section intro-grid" id="about" aria-labelledby="about-title">
    <div class="intro-copy">
      <p class="eyebrow">About</p>
      <h2 id="about-title">기획과 구현을 함께 다루는 게임 개발자</h2>
      {homepage.about.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    <div class="focus-list" aria-label="Current focus areas">
      {homepage.focusAreas.map((area) => (
        <article class="focus-item">
          <h3>{area.title}</h3>
          <p>{area.description}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section skills-section" id="skills" aria-labelledby="skills-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Skills</p>
        <h2 id="skills-title">기술 스택</h2>
      </div>
    </div>
    <div class="skills-grid">
      <article class="skill-panel">
        <h3>Language</h3>
        {homepage.skills.languages.map((group) => (
          <div class="skill-group">
            <strong>{group.level}</strong>
            <ul class="tags" aria-label={`${group.level} languages`}>
              {group.items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        ))}
      </article>
      <article class="skill-panel">
        <h3>Tools</h3>
        {homepage.skills.tools.map((group) => (
          <div class="skill-group">
            <strong>{group.level}</strong>
            <ul class="tags" aria-label={`${group.level} tools`}>
              {group.items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        ))}
      </article>
    </div>
  </section>

  <section class="section" id="projects" aria-labelledby="projects-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Projects</p>
        <h2 id="projects-title">Published Work</h2>
      </div>
      {
        categories.length > 0 && (
          <ul class="category-list" aria-label="Project categories">
            {categories.map((category) => <li>{categoryLabels[category]}</li>)}
          </ul>
        )
      }
    </div>

    {
      projects.length > 0 ? (
        <div class="project-grid">
          {projects.map((project) => <ProjectCard project={project} coverUrl={coverUrls.get(project.data.slug)} />)}
        </div>
      ) : (
        <p class="empty-state">게시된 프로젝트가 아직 없습니다. Markdown 콘텐츠가 추가되면 카드가 자동으로 생성됩니다.</p>
      )
    }
  </section>

  <section class="section workflow" id="workflow" aria-labelledby="workflow-title">
    <p class="eyebrow">Workflow</p>
    <h2 id="workflow-title">Canonical content stays in Git</h2>
    <div class="workflow-steps" aria-label="Content workflow">
      <span>Markdown</span>
      <span>Astro build</span>
      <span>GitHub Pages</span>
      <span>Notion mirror</span>
    </div>
  </section>
</BaseLayout>
