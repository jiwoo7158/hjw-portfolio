---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { categoryLabels, getProjectPath, sortProjects } from "../../lib/projects";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  const showDrafts = import.meta.env.SHOW_DRAFTS === "true";
  return sortProjects(projects.filter((project) => (showDrafts || !project.data.draft) && !project.data.external)).map((project) => ({
    params: { slug: `${project.data.category}/${project.data.slug}` },
    props: { project }
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const homeHref = import.meta.env.BASE_URL;
const canonicalPath = `${homeHref.replace(/\/$/, "")}${getProjectPath(project)}`;
const statusLabels = {
  ongoing: "Ongoing",
  completed: "Completed",
  discontinued: "Discontinued"
} as const;
const contextLabels = {
  personal: "Personal",
  team: "Team",
  coursework: "Coursework"
} as const;
---

<BaseLayout title={project.data.title} description={project.data.description}>
  <article class="project-detail">
    <header class="detail-header">
      <a class="back-link" href={homeHref}>&larr; Projects</a>
      <div class="detail-meta">
        <span>{categoryLabels[project.data.category]}</span>
        {project.data.year && <span>{project.data.year}</span>}
        {project.data.team && <span>{project.data.team}</span>}
      </div>
      <h1>{project.data.title}</h1>
      <p>{project.data.description}</p>
      <dl class="project-summary" aria-label="Project summary">
        {project.data.status && (
          <div>
            <dt>Status</dt>
            <dd>{statusLabels[project.data.status]}</dd>
          </div>
        )}
        {project.data.context && (
          <div>
            <dt>Context</dt>
            <dd>{contextLabels[project.data.context]}</dd>
          </div>
        )}
        {project.data.team && (
          <div>
            <dt>Team</dt>
            <dd>{project.data.team}</dd>
          </div>
        )}
        {project.data.role && (
          <div>
            <dt>My Role</dt>
            <dd>{project.data.role}</dd>
          </div>
        )}
      </dl>
      {
        project.data.tags.length > 0 && (
          <ul class="tags detail-tags" aria-label="Tags">
            {project.data.tags.map((tag) => <li>{tag}</li>)}
          </ul>
        )
      }
      <div class="detail-links" aria-label="Project links">
        {project.data.links.github && <a href={project.data.links.github} target="_blank" rel="noopener noreferrer">GitHub</a>}
        {project.data.links.demo && <a href={project.data.links.demo} target="_blank" rel="noopener noreferrer">Demo</a>}
        {project.data.links.youtube && <a href={project.data.links.youtube} target="_blank" rel="noopener noreferrer">YouTube</a>}
        {project.data.links.paper && <a href={project.data.links.paper} target="_blank" rel="noopener noreferrer">Paper</a>}
      </div>
    </header>
    <div class="prose">
      <Content />
    </div>
    <footer class="detail-footer">
      <p>Canonical path: <code>{canonicalPath}</code></p>
    </footer>
  </article>
</BaseLayout>
